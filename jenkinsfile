pipeline {
    agent any

    environment {
        LABS = credentials('labCreds')
    }

    stages {
        stage('Build'){
            steps {
                // sh 'pip3 install --user pipenv --break-system-packages'
                // sh '/var/lib/jenkins/.local/bin/pipenv remove || exit 0'
                // sh '/var/lib/jenkins/.local/bin/pipenv install'
                // echo "Build completed Successfully."
                sh '''
                    set -e
                    export PATH="/var/lib/jenkins/.local/bin:$PATH"

                    pipenv --version
                    pipenv --rm || true
                    pipenv install
                '''
            }
        }
        stage('Test'){
            steps {
                sh '/usr/bin/jenkins/home/.local/bin/pipenv run pytest'
                // echo "Test completed Successfully."
            }
        }
        stage('Package'){
            steps {
                sh 'zip -r retailAnalysis.zip'
                // echo "Packaging completed Successfully."
            }
        }
        stage('Deploy'){
            steps {
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyCheking=no -r . $LABS_USR@g02.itversity.com:/homeitv026662/retailAnalysis'
                // echo "Deploy completed Successfully. "
            }
        }
    }
}
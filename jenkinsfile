pipeline {
    agent any

    environment {
        LABS = credentials('labCreds')
    }

    stages {
        stage('Build'){
            steps {
                sh 'pip install --user pipenv'
                sh '/usr/bin/jenkins/home/.local/bin/pipenv --rm || exit 0'
                sh '/usr/bin/jenkins/home/.local/bin/pipenv install'
                // echo "Build completed Successfully."
            }
        }
        stage('Test'){
            steps {
                sh '/usr/bin/jenkins/home/.local/bin/pipenv run pytest'
                // echo "Test completed Successfully."
            }
        }
        stage('Package'){
            steps {
                sh 'zip -r retailAnalysis.zip'
                // echo "Packaging completed Successfully."
            }
        }
        stage('Deploy'){
            steps {
                sh 'sshpass -p $LABS_PSW scp -o StrictHostKeyCheking=no -r .
                $LABS_USR@g02.itversity.com:/homeitv026662/retailAnalysis'
                // echo "Deploy completed Successfully. "
            }
        }
    }
}